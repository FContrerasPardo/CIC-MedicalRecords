{
    "$version": "1.0.0",
    "$id": "medical-records.extension",
    "$name": "Medical Records Extension",
    "$description": "Medical records custom process experience",
    "$vendor": "CIC Medical Records",
    "$license": "Apache-2.0",
    "actions": [],
    "rules": [],
    "features": {
        "navbar": [
            {
                "id": "app.navbar.primary",
                "items": [
                    {
                        "id": "app.navbar.medical-records",
                        "component": "medical-records.sidenav",
                        "order": 3
                    }
                ]
            }
        ]
    },
    "routes": [
        {
            "id": "medical-records",
            "path": "medical-records",
            "parentRoute": "",
            "layout": "app.layout.main",
            "component": "medical-records.shell",
            "children": [
                {
                    "id": "medical-records-phase",
                    "path": ":phase",
                    "component": "medical-records.shell",
                    "auth": [
                        "medical-records.auth",
                        "app.extensions.dataLoaderGuard"
                    ]
                }
            ],
            "auth": [
                "medical-records.auth",
                "app.extensions.dataLoaderGuard"
            ]
        }
    ]
}
